# SlimRuimte — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real credentials.

# --- App ---
# Absolute origin, used to build auth redirect URLs (magic link, email confirm).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (eu-west-1, Ireland) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- magicplan (LiDAR floor plan import) ---
MAGICPLAN_API_KEY=

# --- FAL.ai (Flux Kontext Pro + Flux 1.1 Pro Ultra renders) ---
FAL_KEY=

# --- Magnific AI (render upscale upsell) ---
MAGNIFIC_API_KEY=

# --- Stripe Connect (lead fees, render upgrades, property scans) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio (WhatsApp + SMS notifications) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- KvK Open Data (contractor / designer / agent verification) ---
KVK_API_KEY=
